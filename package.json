    "src/starbridge/catalogs/**/*.json",
    "src/starbridge/bridge/java/**/*.java",
    "integrations/**/*.py",
    "integrations/**/*.json",
    "integrations/**/*.js",
    "integrations/**/*.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laxpud/StarBridge.git"
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./integrations/deepseek-harness/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2"
  }
}
