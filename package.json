{
  "name": "@laxpud/dsh-starbridge",
  "version": "0.1.0",
  "description": "Inspect STAR-CCM+ cases and make controlled changes through local MCP tools and a shared audit skill.",
  "type": "module",
  "main": "integrations/deepseek-harness/index.js",
  "files": [
    "skills/",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "LICENSE",
